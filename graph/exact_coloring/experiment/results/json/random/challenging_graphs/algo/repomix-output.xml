"""
SAT solver for Graph Coloring via pysat.
Encodes graph coloring as a SAT problem and uses pysat solvers.
"""

import time
import threading
from pysat.solvers import Glucose3


def sat_coloring_sat(adj_matrix, time_limit=60, seed=None, verbose=False):
    """
    Colors the vertices of a graph using a SAT solver via pysat.

    Uses binary search on k instead of linear search for efficiency.

    Parameters
    ----------
    adj_matrix : list[list[int]]
        Symmetric n x n adjacency matrix, zero diagonal.
    time_limit : float, optional
        Time limit in seconds.
    seed : int, optional
        Random seed (not used by pysat, kept for API consistency).
    verbose : bool, optional
        Print progress information.

    Returns
    -------
    colors : list[int]
        List of size n, color assigned to each vertex.
    nb_colors : int
        Number of colors used.
    """
    n = len(adj_matrix)
    if n == 0:
        return [], 0

    edges = []
    for u in range(n):
        for v in range(n):
            if adj_matrix[u][v]:
                edges.append((u, v))

    from .common import _greedy_coloring, _matrix_to_adj_list
    adj_list = _matrix_to_adj_list(adj_matrix)
    _, greedy_k = _greedy_coloring(adj_list)

    best_k = None
    best_colors = None

    def try_solve(k, time_budget):
        """Try to solve for k colors within time_budget seconds."""
        clauses = []

        # Each vertex must have at least one color
        for v in range(n):
            clause = [v * k + c + 1 for c in range(k)]
            clauses.append(clause)

        # Each vertex cannot have more than one color
        for v in range(n):
            for c1 in range(k):
                for c2 in range(c1 + 1, k):
                    clauses.append([-(v * k + c1 + 1), -(v * k + c2 + 1)])

        # Adjacent vertices cannot have the same color
        for u, v in edges:
            for c in range(k):
                clauses.append([-(u * k + c + 1), -(v * k + c + 1)])

        result = [None]
        exception = [None]
        
        def solve_thread():
            try:
                with Glucose3(bootstrap_with=clauses) as solver:
                    if solver.solve():
                        model = solver.get_model()
                        solution = [-1] * n
                        for lit in model:
                            if lit > 0:
                                var_idx = (lit - 1) % k
                                v = (lit - 1) // k
                                solution[v] = var_idx
                        if -1 not in solution:
                            result[0] = solution
                            return
                result[0] = None
            except Exception as e:
                exception[0] = e

        t = threading.Thread(target=solve_thread)
        t.daemon = True
        t.start()
        t.join(timeout=time_budget)
        
        if t.is_alive():
            # Timeout - can't easily stop pysat, just return None
            return "timeout"
        if exception[0]:
            if verbose:
                print(f"  SAT: Error with k={k}: {exception[0]}")
            return False
        return result[0]

    # Binary search on k
    low, high = 1, greedy_k
    start_time = time.time()
    
    while low <= high:
        elapsed = time.time() - start_time
        remaining = time_limit - elapsed
        if remaining <= 0:
            if verbose:
                print(f"  SAT: Time limit reached")
            break
            
        k = (low + high) // 2
        if verbose:
            print(f"  SAT: trying k={k} (remaining: {remaining:.1f}s)")
        
        # Give at most 10s per attempt
        attempt_time = min(remaining, 10.0)
        result = try_solve(k, attempt_time)
        
        if result == "timeout":
            if verbose:
                print(f"  SAT: timeout at k={k}")
            # Timeout - treat as UNSAT, try higher
            low = k + 1
        elif result is not False:
            # SAT or solution found
            if result is not None:
                best_k = k
                best_colors = result
                if verbose:
                    print(f"  SAT: found coloring with k={k}")
                high = k - 1
            else:
                low = k + 1
        else:
            # Error
            low = k + 1

    # Fallback
    if best_colors is None:
        best_colors = [0] * n
        best_k = n

    return best_colors, best_k


def sat_coloring(adj_matrix, time_limit=60, seed=None, verbose=False):
    """
    Colors the vertices of a graph using SAT encoding with pysat solvers.
    """
    return sat_coloring_sat(adj_matrix, time_limit, seed, verbose)
