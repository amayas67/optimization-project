#!/usr/bin/env python3
"""
SCIP solver for Graph Coloring via pyscipopt.
Uses SCIP MIP solver for graph coloring optimization.
"""

import pyscipopt


def scip_coloring(adj_matrix, time_limit=60, seed=None, verbose=False):
    """
    Colors the vertices of a graph using SCIP MIP solver.

    Parameters
    ----------
    adj_matrix : list[list[int]]
        Symmetric n x n adjacency matrix, zero diagonal.
    time_limit : float, optional
        Time limit in seconds (default: 60).
    seed : int, optional
        Random seed for SCIP.
    verbose : bool, optional
        Print progress information.

    Returns
    -------
    colors : list[int]
        List of size n, color assigned to each vertex.
    nb_colors : int
        Number of colors used.
    """
    n = len(adj_matrix)
    if n == 0:
        return [], 0

    edges = []
    for u in range(n):
        for v in range(n):
            if adj_matrix[u][v]:
                edges.append((u, v))

    from .common import _greedy_coloring, _matrix_to_adj_list
    adj_list = _matrix_to_adj_list(adj_matrix)
    _, greedy_k = _greedy_coloring(adj_list)

    best_k = None
    best_colors = None

    for k in range(1, greedy_k + 1):
        model = pyscipopt.Model()
        if verbose:
            model.setParam('display/verblevel', 5)
        else:
            model.setParam('display/verblevel', 0)
        
        if seed is not None:
            model.setParam('randomization/seed', seed)
        model.setParam('limits/time', min(time_limit / max(1, greedy_k), 30))
        model.setParam('limits/nodes', 10000)
        model.setParam('limits/gap', 0.01)

        x = {}
        for v in range(n):
            for c in range(k):
                x[v, c] = model.addVar(vtype='BINARY', name=f'x_{v}_{c}')

        for v in range(n):
            model.addCons(pyscipopt.quicksum(x[v, c] for c in range(k)) == 1)

        for u, v in edges:
            for c in range(k):
                model.addCons(x[u, c] + x[v, c] <= 1)

        model.optimize()

        status = model.getStatus()
        if status in ['optimal', 'feasible']:
            solution = [-1] * n
            for v in range(n):
                for c in range(k):
                    if model.getVal(x[v, c]) > 0.5:
                        solution[v] = c
            
            if -1 not in solution:
                if best_k is None or k < best_k:
                    best_k = k
                    best_colors = solution
                    if status == 'optimal':
                        break

        model.freeProb()

    if best_colors is None:
        best_colors = [0] * n
        best_k = n

    return best_colors, best_k


def scip_coloring_fixed_k(adj_matrix, k, time_limit=60, seed=None, verbose=False):
    """
    SCIP variant that tries to find a valid coloring with a fixed number of colors k.
    """
    n = len(adj_matrix)
    if n == 0:
        return [], 0

    model = pyscipopt.Model()
    if verbose:
        model.setParam('display/verblevel', 5)
    else:
        model.setParam('display/verblevel', 0)
    
    if seed is not None:
        model.setParam('randomization/seed', seed)
    model.setParam('limits/time', time_limit)

    x = {}
    for v in range(n):
        for c in range(k):
            x[v, c] = model.addVar(vtype='BINARY', name=f'x_{v}_{c}')

    for v in range(n):
        model.addCons(pyscipopt.quicksum(x[v, c] for c in range(k)) == 1)

    for u in range(n):
        for v in range(u + 1, n):
            if adj_matrix[u][v]:
                for c in range(k):
                    model.addCons(x[u, c] + x[v, c] <= 1)

    model.optimize()

    status = model.getStatus()
    if status in ['optimal', 'feasible']:
        solution = [-1] * n
        for v in range(n):
            for c in range(k):
                if model.getVal(x[v, c]) > 0.5:
                    solution[v] = c
        return solution, k
    else:
        from .common import _greedy_coloring, _matrix_to_adj_list
        adj_list = _matrix_to_adj_list(adj_matrix)
        _, greedy_k = _greedy_coloring(adj_list)
        return [0] * n, greedy_k
