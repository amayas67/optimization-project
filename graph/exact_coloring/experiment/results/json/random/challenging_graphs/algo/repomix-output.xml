#!/usr/bin/env python3
"""
Z3 SMT solver for Graph Coloring.
Uses Z3 to find valid graph colorings via symbolic constraint solving.
"""

import z3


def z3_coloring(adj_matrix, time_limit=60, seed=None, verbose=False):
    """
    Colors the vertices of a graph using Z3 SMT solver.

    Parameters
    ----------
    adj_matrix : list[list[int]]
        Symmetric n x n adjacency matrix, zero diagonal.
    time_limit : float, optional
        Time limit in seconds (default: 60).
    seed : int, optional
        Random seed (not used by Z3, kept for API consistency).
    verbose : bool, optional
        Print progress information.

    Returns
    -------
    colors : list[int]
        List of size n, color assigned to each vertex.
    nb_colors : int
        Number of colors used.
    """
    n = len(adj_matrix)
    if n == 0:
        return [], 0

    edges = []
    for u in range(n):
        for v in range(n):
            if adj_matrix[u][v]:
                edges.append((u, v))

    from .common import _greedy_coloring, _matrix_to_adj_list
    adj_list = _matrix_to_adj_list(adj_matrix)
    _, greedy_k = _greedy_coloring(adj_list)

    best_k = None
    best_colors = None

    for k in range(1, greedy_k + 1):
        solver = z3.Solver()
        solver.set("timeout", int(time_limit * 1000))

        colors = [z3.Int(f'c_{i}') for i in range(n)]

        for c in colors:
            solver.add(c >= 0, c < k)

        for u, v in edges:
            solver.add(colors[u] != colors[v])

        if solver.check() == z3.sat:
            model = solver.model()
            solution = [model[colors[i]].as_long() for i in range(n)]
            if best_k is None or k < best_k:
                best_k = k
                best_colors = solution
                if k == 1 or (best_k is not None and k == best_k):
                    break
        elif solver.reason_unknown() == "unknown":
            if verbose:
                print(f"  Z3: Unknown result for k={k}")

    if best_colors is None:
        from .common import _verify_coloring
        best_colors = [0] * n
        best_k = greedy_k
        if not _verify_coloring(adj_matrix, best_colors):
            for i in range(n):
                best_colors[i] = greedy_k - 1

    return best_colors, best_k


def z3_coloring_fixed_k(adj_matrix, k, time_limit=60, seed=None, verbose=False):
    """
    Z3 variant that tries to find a valid coloring with a fixed number of colors k.
    """
    n = len(adj_matrix)
    if n == 0:
        return [], 0

    solver = z3.Solver()
    solver.set("timeout", int(time_limit * 1000))

    colors = [z3.Int(f'c_{i}') for i in range(n)]

    for c in colors:
        solver.add(c >= 0, c < k)

    for u in range(n):
        for v in range(u + 1, n):
            if adj_matrix[u][v]:
                solver.add(colors[u] != colors[v])

    if solver.check() == z3.sat:
        model = solver.model()
        solution = [model[colors[i]].as_long() for i in range(n)]
        return solution, k
    else:
        return [0] * n, k
